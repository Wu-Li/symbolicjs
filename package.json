{
  "name": "symbolicjs",
  "version": "0.1.0",
  "description": "Computer algebra extensions for MathJS, beginning with first-class equations.",
  "type": "module",
  "license": "MIT",
  "author": "John Lott",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wu-Li/symbolicjs.git"
  },
  "bugs": {
    "url": "https://github.com/Wu-Li/symbolicjs/issues"
  },
  "homepage": "https://github.com/Wu-Li/symbolicjs#readme",
  "keywords": [
    "algebra",
    "cas",
    "equation",
    "mathjs",
    "symbolic-math"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:pack": "node scripts/verify-pack.mjs",
    "test:benchmark": "node scripts/benchmark.mjs",
    "check": "npm run typecheck && npm run test:coverage && npm run build && npm run test:benchmark && npm run test:pack",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "mathjs": ">=15.2.0 <16"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "4.9.0",
    "mathjs": "15.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
